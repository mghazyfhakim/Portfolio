{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "last_updated": "2026-10-20",
  "author": "AI Engineering Team - Z.ai",
  "description": "Tool registry untuk Hermes-2-Pro-Llama-3-8B. Setiap tool punya JSON Schema untuk parameter - Hermes akan menggunakan ini sebagai guide untuk function call.",
  "tools": [
    {
      "name": "get_inventory",
      "description": "Cek stok produk berdasarkan SKU. Return: stok saat ini, warehouse, reorder point, harga per unit.",
      "parameters": {
        "type": "object",
        "properties": {
          "product_sku": {
            "type": "string",
            "description": "SKU produk yang ingin dicek stoknya. Format: SKU-XXX (huruf kapital, dipisah dash). Contoh: SKU-001, SKU-AB12."
          }
        },
        "required": ["product_sku"],
        "additionalProperties": false
      },
      "category": "read",
      "destructive": false,
      "example_call": {
        "name": "get_inventory",
        "parameters": {
          "product_sku": "SKU-001"
        }
      }
    },
    {
      "name": "search_product",
      "description": "Cari produk berdasarkan kata kunci (nama produk, kategori, atau deskripsi parsial). Return: list produk dengan SKU, nama, harga, stok ringkas.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Kata kunci pencarian. Bisa nama produk, kategori, atau bagian dari deskripsi. Case-insensitive. Contoh: 'kopi', 'bahan kimia', 'SKU-'."
          },
          "limit": {
            "type": "integer",
            "description": "Jumlah maksimal hasil yang diinginkan. Default: 10. Max: 50.",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "category": "read",
      "destructive": false,
      "example_call": {
        "name": "search_product",
        "parameters": {
          "query": "kopi arabika",
          "limit": 5
        }
      }
    },
    {
      "name": "create_quote",
      "description": "Buat penawaran/quote untuk customer. Sebelum panggil tool ini, sebaiknya cek stok via get_inventory untuk memastikan ketersediaan.",
      "parameters": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "ID customer di ERP. Format: CUST-XXX. Contoh: CUST-001."
          },
          "items": {
            "type": "array",
            "description": "List item produk yang di-quote. Minimal 1 item.",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "product_sku": {
                  "type": "string",
                  "description": "SKU produk."
                },
                "quantity": {
                  "type": "integer",
                  "description": "Jumlah unit. Harus integer positif.",
                  "minimum": 1
                },
                "unit_price": {
                  "type": "number",
                  "description": "Harga per unit dalam Rupiah. Opsional - jika tidak diisi, akan pakai harga default ERP.",
                  "minimum": 0
                }
              },
              "required": ["product_sku", "quantity"],
              "additionalProperties": false
            }
          },
          "payment_terms": {
            "type": "string",
            "description": "Termin pembayaran.",
            "enum": ["net_15", "net_30", "net_60", "cod"]
          },
          "_confidence": {
            "type": "number",
            "description": "Confidence score Hermes terhadap tool call ini (0.0-1.0). Wajib untuk aksi destruktif.",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "required": ["customer_id", "items", "payment_terms", "_confidence"],
        "additionalProperties": false
      },
      "category": "write",
      "destructive": true,
      "example_call": {
        "name": "create_quote",
        "parameters": {
          "customer_id": "CUST-001",
          "items": [
            {
              "product_sku": "SKU-001",
              "quantity": 10
            }
          ],
          "payment_terms": "net_30",
          "_confidence": 0.95
        }
      }
    },
    {
      "name": "get_invoice",
      "description": "Ambil detail invoice berdasarkan invoice ID. Return: nomor invoice, customer, items, total, status pembayaran, due date.",
      "parameters": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string",
            "description": "ID invoice di ERP. Format: INV-YYYYMM-XXX. Contoh: INV-202610-001."
          }
        },
        "required": ["invoice_id"],
        "additionalProperties": false
      },
      "category": "read",
      "destructive": false,
      "example_call": {
        "name": "get_invoice",
        "parameters": {
          "invoice_id": "INV-202610-001"
        }
      }
    },
    {
      "name": "list_customers",
      "description": "Daftar customer di ERP dengan filter opsional. Return: list customer dengan ID, nama, kontak, credit limit.",
      "parameters": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "description": "Filter opsional untuk pencarian customer.",
            "properties": {
              "industry": {
                "type": "string",
                "description": "Filter berdasarkan industri. Contoh: 'manufacturing', 'distribusi', 'jasa'."
              },
              "city": {
                "type": "string",
                "description": "Filter berdasarkan kota. Contoh: 'Jakarta', 'Surabaya', 'Bandung'."
              },
              "active_only": {
                "type": "boolean",
                "description": "Hanya tampilkan customer yang masih aktif. Default: true.",
                "default": true
              }
            },
            "additionalProperties": false
          },
          "limit": {
            "type": "integer",
            "description": "Jumlah maksimal hasil. Default: 20. Max: 100.",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "category": "read",
      "destructive": false,
      "example_call": {
        "name": "list_customers",
        "parameters": {
          "filter": {
            "industry": "manufacturing",
            "active_only": true
          },
          "limit": 10
        }
      }
    }
  ]
}
